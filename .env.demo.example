# Demo stack environment variables.
# Copy this file to .env.demo on the EC2 and fill in real values.
# The .env.demo file is gitignored - never commit secrets.
#
# Generate a strong DB password (one-liner):
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32

DEMO_DB_PASSWORD=replace-with-strong-random-password
DEMO_PUBLIC_API_URL=http://51.24.16.185:8001

# Google Analytics 4 measurement ID for the demo. Format: G-XXXXXXXXXX
# Leave blank to disable analytics.
# Get yours at https://analytics.google.com → Admin → Data Streams
DEMO_GA_ID=
